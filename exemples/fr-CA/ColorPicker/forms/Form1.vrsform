    name: "Form1",
    title: "Sélecteur de couleur",
    width: 460.0,
    height: 230.0,
    events: {
        Load: "form1_load",
    },
    controls: [
        Control(
            name: "slider1",
            kind: Slider,
            x: 16.0,
            y: 20.0,
            width: 260.0,
            height: 22.0,
            text: "Rouge",
            visible: true,
            enabled: true,
            events: {
                ValueChanged: "slider1_value_changed",
            },
            value: 128.0,
            maximum: 255.0,
        ),
        Control(
            name: "slider2",
            kind: Slider,
            x: 16.0,
            y: 56.0,
            width: 260.0,
            height: 22.0,
            text: "Vert",
            visible: true,
            enabled: true,
            events: {
                ValueChanged: "slider2_value_changed",
            },
            value: 128.0,
            maximum: 255.0,
        ),
        Control(
            name: "slider3",
            kind: Slider,
            x: 16.0,
            y: 92.0,
            width: 260.0,
            height: 22.0,
            text: "Bleu",
            visible: true,
            enabled: true,
            events: {
                ValueChanged: "slider3_value_changed",
            },
            value: 128.0,
            maximum: 255.0,
        ),
        Control(
            name: "panel1",
            kind: Panel,
            x: 300.0,
            y: 20.0,
            width: 140.0,
            height: 100.0,
            text: "",
            visible: true,
            enabled: true,
            back_color: Some((128, 128, 128, 255)),
        ),
        Control(
            name: "label1",
            kind: Label,
            x: 16.0,
            y: 150.0,
            width: 420.0,
            height: 20.0,
            text: "#808080",
            visible: true,
            enabled: true,
            font_size: Some(18.0),
        ),
    ],
)
