// Visual Rust Studio — conception de la fenêtre Form1.
// Métadonnées de présentation uniquement (aucun code). Modifiées par le concepteur.
FormDocument(
    format_version: 1,
    name: "Form1",
    title: "Deux fenêtres",
    width: 420.0,
    height: 180.0,
    controls: [
        Control(
            name: "label1",
            kind: Label,
            x: 24.0,
            y: 24.0,
            width: 360.0,
            height: 36.0,
            text: "Bonjour, le monde !",
            visible: true,
            enabled: true,
            font_size: Some(20.0),
        ),
        Control(
            name: "button1",
            kind: Button,
            x: 24.0,
            y: 90.0,
            width: 220.0,
            height: 32.0,
            text: "Quel est votre nom ?",
            visible: true,
            enabled: true,
            events: {
                Click: "button1_click",
            },
        ),
    ],
)
