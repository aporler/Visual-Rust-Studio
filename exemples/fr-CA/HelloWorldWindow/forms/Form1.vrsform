// Visual Rust Studio — conception de la fenêtre Form1.
// Métadonnées de présentation uniquement (aucun code). Modifiées par le concepteur.
FormDocument(
    format_version: 1,
    name: "Form1",
    title: "Hello World (fenêtre)",
    width: 420.0,
    height: 170.0,
    controls: [
        Control(
            name: "label1",
            kind: Label,
            x: 24.0,
            y: 24.0,
            width: 360.0,
            height: 40.0,
            text: "Bonjour, le monde !",
            visible: true,
            enabled: true,
            font_size: Some(24.0),
        ),
        Control(
            name: "button1",
            kind: Button,
            x: 24.0,
            y: 96.0,
            width: 120.0,
            height: 32.0,
            text: "Fermer",
            visible: true,
            enabled: true,
            events: {
                Click: "button1_click",
            },
        ),
    ],
)
